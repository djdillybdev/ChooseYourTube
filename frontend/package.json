{
	"name": "chooseyourtube",
	"private": true,
	"version": "0.1.0",
	"license": "GPL-3.0-only",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"api:schema": "cd ../backend && UV_CACHE_DIR=${TMPDIR:-/tmp}/chooseyourtube-uv-cache uv run python scripts/export_openapi.py ../frontend/openapi.json",
		"api:types": "openapi-typescript openapi.json -o src/lib/types/generated.ts && prettier --write openapi.json src/lib/types/generated.ts",
		"api:generate": "pnpm run api:schema && pnpm run api:types",
		"api:check": "node scripts/check-api-contract.mjs",
		"test:unit": "vitest run --project server --project component",
		"test:component": "vitest run --project component",
		"test:coverage": "vitest run --project server --project component --coverage",
		"test:e2e:setup": "playwright install chromium",
		"test:e2e:fast": "playwright test",
		"test:e2e:full": "../scripts/run_e2e.sh",
		"test:e2e": "pnpm run test:e2e:fast && pnpm run test:e2e:full",
		"test:ci": "pnpm run api:check && pnpm run test:coverage && pnpm run test:e2e",
		"test": "pnpm run test:ci"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.2",
		"@eslint/compat": "^2.0.1",
		"@eslint/js": "^9.39.2",
		"@playwright/test": "^1.58.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.50.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.2.8",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24",
		"@vitest/coverage-v8": "4.0.18",
		"daisyui": "^5.5.14",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.1.0",
		"jsdom": "^27.0.1",
		"msw": "^2.11.5",
		"openapi-typescript": "7.10.1",
		"playwright": "^1.58.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.48.2",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.1",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"svelte-persisted-state": "^1.2.0"
	}
}
