---
# Copy this file to vault.yml, replace every required value, then run:
# ansible-vault encrypt inventory/production/group_vars/chooseyourtube/vault.yml
vault_chooseyourtube_youtube_api_key: "replace-me"
vault_chooseyourtube_auth_secret: "replace-with-openssl-rand-hex-32"
vault_chooseyourtube_postgres_password: "replace-with-openssl-rand-hex-24"

# Optional Google OAuth and private GHCR credentials.
vault_chooseyourtube_google_client_id: ""
vault_chooseyourtube_google_client_secret: ""
vault_chooseyourtube_registry_username: ""
vault_chooseyourtube_registry_token: ""
