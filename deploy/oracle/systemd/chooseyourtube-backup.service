[Unit]
Description=Back up the ChooseYourTube PostgreSQL database
Requires=docker.service
After=docker.service chooseyourtube.service

[Service]
Type=oneshot
WorkingDirectory=/opt/chooseyourtube
EnvironmentFile=/opt/chooseyourtube/.env
ExecStart=/opt/chooseyourtube/deploy/oracle/bin/backup.sh
UMask=0077
