# Required: edit these four values before running sudo ./chooseyourtube setup.
APP_DOMAIN=chooseyourtube.duckdns.org
ACME_EMAIL=your-email@example.com
YOUTUBE_API_KEY=replace-me
REGISTRATION_EMAIL_ALLOWLIST=your-login-email@example.com

# Optional Google OAuth subscription discovery.
YOUTUBE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional operational overrides.
BACKUP_DIR=/var/backups/chooseyourtube
ALLOW_LOW_RESOURCE=false

# Generated by setup. Do not share or change these after first deployment.
AUTH_SECRET=
POSTGRES_PASSWORD=
