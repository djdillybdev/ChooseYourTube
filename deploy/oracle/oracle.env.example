# Docker Compose production stack. Keep this exact path list unchanged.
COMPOSE_PROJECT_NAME=chooseyourtube
CHOOSEYOURTUBE_VERSION=replace-with-release-version
CADDY_VERSION=2.11.4

APP_ENV=production
APP_MODE=full
APP_DOMAIN=tube.example.com
ACME_EMAIL=admin@example.com
API_ORIGIN=https://tube.example.com
API_CORS_ORIGINS=https://tube.example.com

YOUTUBE_API_KEY=replace-me
AUTH_SECRET=replace-me
REGISTRATION_ENABLED=true
# Oracle deployments require one or more exact addresses while registration is enabled.
REGISTRATION_EMAIL_ALLOWLIST=
REGISTRATION_ALLOWLIST_REQUIRED=true
BACKGROUND_JOBS_ENABLED=true
YOUTUBE_DAILY_QUOTA_BUDGET=8000

POSTGRES_USER=chooseyourtube
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=chooseyourtube
DATABASE_POOL_MODE=persistent

YOUTUBE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
ALLOW_INSECURE_OAUTH_TRANSPORT=false

ECHO_SQL=false
DEBUG_LOGS=false
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=60

CADDY_CPUS=0.25
CADDY_MEMORY_LIMIT=128m
FRONTEND_CPUS=0.50
FRONTEND_MEMORY_LIMIT=384m
BACKEND_CPUS=0.75
BACKEND_MEMORY_LIMIT=768m
WORKER_CPUS=1.0
WORKER_MEMORY_LIMIT=768m
POSTGRES_CPUS=0.75
POSTGRES_MEMORY_LIMIT=1g
REDIS_CPUS=0.25
REDIS_MEMORY_LIMIT=256m
MIGRATE_CPUS=1.0
MIGRATE_MEMORY_LIMIT=768m
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=5

BACKUP_DIR=/var/backups/chooseyourtube
BACKUP_RETENTION_DAYS=14
ALLOW_LOW_RESOURCE=false
