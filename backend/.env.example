APP_ENV=local
APP_MODE=full
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chooseyourtube
DATABASE_POOL_MODE=persistent
REDIS_URL=redis://localhost:6379/0
API_ORIGIN=http://localhost:5173
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
YOUTUBE_API_KEY=replace-me
AUTH_SECRET=change-me-in-production-with-at-least-32-characters
REGISTRATION_ENABLED=true
# Optional comma-separated exact emails. Empty means registration is open.
REGISTRATION_EMAIL_ALLOWLIST=
BACKGROUND_JOBS_ENABLED=true
YOUTUBE_OAUTH_ENABLED=false
DEMO_LOGIN_ENABLED=false
YOUTUBE_DAILY_QUOTA_BUDGET=8000
DEMO_USER_EMAIL=
DEMO_MAINTENANCE_SECRET=
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
ALLOW_INSECURE_OAUTH_TRANSPORT=false
ECHO_SQL=false
DEBUG_LOGS=false
